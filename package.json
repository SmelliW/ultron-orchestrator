{
  "name": "ultron-orchestrator",
  "version": "0.1.0-beta",
  "description": "AI Personal Orchestrator Agent - Ultron Framework (Smart Planning + Context Memory Manager)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"ts-node --watch --project typescriptconfig.json src/index.ts\" \"npm run memory:update\"",
    "start": "node scripts/run-api.cjs",
    "memory:update": "node dist/memory_manager.js",
    "build": "npx tsc",
    "lint": "eslint src/",
    "test": "jest",
    "version:0.1.0": "npm version 0.1.0 --no-git-tag-version && git commit -m 'v0.1.0: Initial Ultron release'\n\n",
    "version:1.0.0": "npm version 1.0.0 --no-git-tag-version && git commit -m 'v1.0.0: Stable Ultron release'\n\n"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@prisma/client": "^7.10.1",
    "@prisma/engines": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prisma": "^8.0.0-rc.33",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "ultron",
    "orchestrator",
    "smart-planning",
    "context-memory",
    "ai-agent",
    "planner",
    "executor",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ultron-orchestrator.git"
  },
  "license": "MIT"
}
