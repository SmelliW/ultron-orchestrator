# Configuration for Ultron/Jarvis Agent Orchestrator
# Uses Claude Code as the central brain and executor

# Ollama & Claude settings
OLLAMA_MODEL=qwen3.5:4b
CLAUDE_CODE_DIR=~/.claude
SKILLS_ENABLED=true

# Memory Manager - persistent observation database
MEMORY_DB_PATH=~/.claude/mem/db.sqlite
MEMORY_SYNC_TOKEN=your-cmem-sync-token-here

# Permissions management (prevents unnecessary prompts)
PERMISSION_MODE=auto  # "acceptEdits", "auto", "bypassPermissions", "default"

# Project settings
PROJECT_NAME="Ultron"
EXECUTION_TIMEOUT=360000  # milliseconds
